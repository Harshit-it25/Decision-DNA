{
  "name": "decision-dna-root",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"magenta,cyan\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "build": "cd frontend && npm run build",
    "build:frontend": "cd frontend && npm run build",
    "install:frontend": "cd frontend && npm install",
    "start": "uvicorn app.main:app --host 127.0.0.1 --port 8000"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
